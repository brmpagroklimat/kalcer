---
import FeatureGrid from './FeatureGrid.astro';
---
<section class="hero wrap">
  <div class="intro">
    <p class="kicker">Agroclimate Intelligence</p>
    <h1>Klinik Agroklimat Cerdas.</h1>
    <p class="lede">Baca iklim dan air, lalu putuskan waktu tanam, pengairan, dan pemupukan dengan lebih tepat.</p>
  </div>

  <div class="side">
    <div class="geo" aria-hidden="true">
      <span style="grid-column:1;grid-row:1;aspect-ratio:1;background:var(--deep);border-radius:100% 0 0 0"></span>
      <span style="grid-column:2;grid-row:1;aspect-ratio:1;background:var(--sky);border-radius:0 0 100% 0"></span>
      <span style="grid-column:3;grid-row:1 / span 2;background:var(--coral);border-radius:100% 0 0 100% / 50% 0 0 50%"></span>
      <span style="grid-column:4;grid-row:1;aspect-ratio:1;background:var(--sun);border-radius:50%"></span>
      <span style="grid-column:1;grid-row:2;aspect-ratio:1;background:var(--sand);border-radius:50%"></span>
      <span style="grid-column:2;grid-row:2;aspect-ratio:1;background:var(--leaf);border-radius:0 100% 0 100%"></span>
      <span style="grid-column:4;grid-row:2;aspect-ratio:1;background:var(--sand);border-radius:0 0 100% 0"></span>
    </div>
    <FeatureGrid />
  </div>
</section>

<style>
  .hero {
    padding-block: 16px 96px;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 56px;
  }
  .intro {
    flex: 1 1 320px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-top: clamp(0px, 9vw, 120px);
  }
  .kicker {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--leaf);
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(40px, 4.6vw, 60px);
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .lede { font-size: 18px; line-height: 1.6; color: var(--body); max-width: 420px; }
  .side {
    flex: 1.9 1 560px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .geo {
    align-self: flex-end;
    width: 168px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: repeat(2, auto);
  }
  .geo span { display: block; }
  @media (max-width: 640px) {
    .hero { padding-block: 40px 64px; gap: 40px; }
    .side { flex-basis: 100%; }
    .geo { width: 176px; }
  }
</style>
