---
import Rainfall from './Rainfall.astro';
import { chatTool } from '../data/tools';
---
<header class="hero">
  <div class="wrap">
    <nav class="top" aria-label="Utama">
      <a class="brand" href="/">
        <img src="/favicon.svg" alt="" width="36" height="36" />
        <span>KALCER</span>
      </a>
      {chatTool.href && (
        <a class="top-link" href={chatTool.href} target="_blank" rel="noopener">Tanya KALCER</a>
      )}
    </nav>

    <div class="intro">
      <h1>Klinik Agroklimat Cerdas</h1>
      <div class="lede">
        <p>Baca pola hujan dan air di lahanmu, lalu tentukan waktu tanam, pengairan, dan pemupukan dengan lebih tepat.</p>
        <a class="cta" href="#alat">Lihat alat</a>
      </div>
    </div>

    <Rainfall />
  </div>
</header>

<style>
  .hero {
    background: var(--ink);
    color: var(--leaf);
    padding-block: 1.5rem clamp(2.5rem, 6vw, 4.5rem);
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.6rem;
    letter-spacing: 0.04em;
  }
  .top-link {
    font-size: var(--step--1);
    font-weight: 600;
    text-underline-offset: 0.25em;
  }
  .intro {
    margin-block: clamp(3rem, 9vw, 6.5rem) clamp(2.5rem, 6vw, 4rem);
    display: grid;
    gap: 2rem;
    align-items: end;
  }
  h1 {
    font-family: var(--font-display);
    font-size: var(--step-hero);
    font-weight: 800;
    line-height: 0.88;
    letter-spacing: -0.01em;
    max-width: 9ch;
    text-wrap: balance;
  }
  .lede { display: grid; gap: 1.75rem; justify-items: start; max-width: 34rem; }
  .lede p { font-size: var(--step-1); line-height: 1.5; color: color-mix(in srgb, var(--leaf) 88%, transparent); }
  .cta {
    display: inline-block;
    background: var(--harvest);
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
    padding: 0.85rem 1.6rem;
    border-radius: 999px;
    transition: background-color 150ms;
  }
  .cta:hover { background: #ecc35a; }
  @media (min-width: 60rem) {
    .intro { grid-template-columns: 1.3fr 1fr; }
  }
</style>
