---
---
<header class="wrap">
  <a class="brand" href="/">
    <img src="/logo.png" alt="" width="38" height="44" />
    <span>KALCER</span>
  </a>
  <nav aria-label="Navigasi utama">
    <a href="#fitur">Fitur</a>
    <a href="#tanya">Tanya KALCER</a>
    <a href="#tentang">Tentang</a>
    <a class="event" href="/event/">Pendaftaran event 2–3 Des</a>
  </nav>
</header>

<style>
  header {
    padding-top: 20px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: 0.12em;
    color: var(--ink);
  }
  /* logo tanpa efek hover */
  .brand:hover { color: var(--ink); }
  .brand img { display: block; width: 38px; height: 44px; }
  nav { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 32px; }
  nav a {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--nav);
    text-decoration: none;
    padding-block: 12px;
  }
  nav a:hover { color: var(--deep); }
  nav a.event {
    color: var(--ink);
    background: var(--sun);
    border-radius: 6px;
    padding: 10px 14px;
  }
  nav a.event:hover { background: #f8d176; color: var(--ink); }
</style>
