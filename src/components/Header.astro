---
---
<header class="wrap">
  <a class="brand" href="/">
    <img src="/logo-kalcer.png" alt="KALCER" width="212" height="40" />
  </a>
  <nav aria-label="Navigasi utama">
    <a href="#fitur">Fitur</a>
    <a href="#tanya">Tanya Gita</a>
    <a href="#tentang">Tentang</a>
  </nav>
</header>

<style>
  header {
    padding-top: 20px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  /* logo tanpa efek hover */
  .brand { display: block; line-height: 0; }
  .brand img { display: block; width: 212px; height: 40px; }
  nav { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 32px; }
  nav a {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--nav);
    text-decoration: none;
    padding-block: 12px;
  }
  nav a:hover { color: var(--deep); }
  @media (max-width: 420px) {
    .brand img { width: 170px; height: 32px; }
  }
</style>
