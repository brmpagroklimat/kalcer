---
import Icon from './Icon.astro';
import type { Tool } from '../data/tools';
interface Props { tool: Tool }
const { tool } = Astro.props;
const Tag = tool.href ? 'a' : 'div';
const linkAttrs = tool.href ? { href: tool.href, target: '_blank', rel: 'noopener' } : { 'aria-disabled': 'true' };
---
<li>
  <Tag class:list={['row', { soon: !tool.href }]} {...linkAttrs}>
    <span class="icon"><Icon name={tool.icon} /></span>
    <span class="text">
      <h4>{tool.title}</h4>
      <p>{tool.description}</p>
    </span>
    <span class="status">
      {tool.href ? (
        <>
          Buka
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
            <path d="M6 3H3v10h10v-3M9 2h5v5M14 2 7.5 8.5" />
          </svg>
          <span class="sr-only">(tab baru)</span>
        </>
      ) : 'Segera hadir'}
    </span>
  </Tag>
</li>

<style>
  .row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.4rem 1.25rem;
    padding: 1.5rem 1rem;
    margin-inline: -1rem;
    border-radius: 14px;
    text-decoration: none;
    color: var(--ink);
    transition: background-color 150ms;
  }
  a.row:hover { background: var(--leaf-deep); }
  .icon {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 12px;
    background: var(--white);
    color: var(--paddy);
    box-shadow: inset 0 0 0 1px var(--leaf-deep);
  }
  h4 {
    margin: 0;
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1.25;
  }
  p { color: var(--muted); max-width: 52ch; margin-top: 0.25rem; }
  .status {
    grid-column: 2;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--rain);
  }
  .soon .status {
    color: var(--muted);
    font-weight: 600;
    background: var(--leaf-deep);
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
  }
  .soon .icon { color: var(--muted); }
  @media (min-width: 48rem) {
    .row { grid-template-columns: auto 1fr auto; align-items: center; }
    .icon { grid-row: auto; }
    .status { grid-column: 3; justify-self: end; }
  }
</style>
