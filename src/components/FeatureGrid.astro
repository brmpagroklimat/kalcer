---
import ToolIcon from './ToolIcon.astro';
import { tools } from '../data/tools';
---
<div id="fitur" class="grid">
  {tools.map((tool) => {
    const Tag = tool.href ? 'a' : 'div';
    const attrs = tool.href ? { href: tool.href, target: '_blank', rel: 'noopener' } : {};
    return (
      <Tag class:list={['card', { soon: !tool.href }]} {...attrs}>
        <span class="top">
          <ToolIcon name={tool.icon} />
          {tool.href ? (
            <span class="open" aria-hidden="true">
              Buka
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 11 11 5M6 5h5v5" />
              </svg>
            </span>
          ) : (
            <span class="badge">Segera hadir</span>
          )}
        </span>
        <span class="text">
          <h3>{tool.title}</h3>
          <p>{tool.description}</p>
        </span>
        {tool.href && <span class="sr-only">(tab baru)</span>}
      </Tag>
    );
  })}
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    scroll-margin-top: 24px;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px 22px 22px;
    background: var(--white);
    text-decoration: none;
    color: inherit;
    position: relative;
    transition: background-color 200ms;
  }
  /* garis aksen yang tumbuh dari kiri di bawah kartu */
  a.card::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: var(--deep);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 320ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  a.card:hover, a.card:focus-visible { background: #f7fbfc; color: inherit; }
  a.card:hover::after, a.card:focus-visible::after { transform: scaleX(1); }
  h3 { transition: color 200ms; }
  a.card:hover h3, a.card:focus-visible h3 { color: var(--deep); }
  a.card:focus-visible { outline-offset: -3px; }
  .open {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--deep);
    opacity: 0;
    transform: translate(-6px, 4px);
    transition: opacity 200ms, transform 300ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  a.card:hover .open, a.card:focus-visible .open { opacity: 1; transform: none; }
  @media (hover: none) {
    .open { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    a.card::after, .open, h3 { transition: none; }
  }
  .text { display: flex; flex-direction: column; gap: 4px; }
  h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    color: var(--ink);
  }
  p { font-size: 14px; line-height: 1.5; color: var(--body); }
  .top { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; }
  .badge {
    white-space: nowrap;
    font-size: 12px;
    font-weight: 700;
    color: var(--muted);
    background: var(--paper);
    border: 1px solid var(--line);
    padding: 3px 10px;
    border-radius: 999px;
  }
</style>
