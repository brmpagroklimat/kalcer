---
import ToolIcon from './ToolIcon.astro';
import { tools } from '../data/tools';
---
<div id="fitur" class="grid">
  {tools.map((tool) => {
    const Tag = tool.href ? 'a' : 'div';
    const attrs = tool.href ? { href: tool.href, target: '_blank', rel: 'noopener' } : {};
    return (
      <Tag class:list={['card', { soon: !tool.href }]} {...attrs}>
        <ToolIcon name={tool.icon} />
        <span class="text">
          <h3>{tool.title}</h3>
          <p>{tool.description}</p>
        </span>
        {tool.href ? <span class="sr-only">(tab baru)</span> : <span class="badge">Segera hadir</span>}
      </Tag>
    );
  })}
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    scroll-margin-top: 24px;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 28px;
    background: var(--white);
    text-decoration: none;
    color: inherit;
    transition: background-color 150ms;
  }
  a.card:hover { background: #fbfaf7; color: inherit; }
  a.card:hover h3 { color: var(--deep); }
  .text { display: flex; flex-direction: column; gap: 6px; }
  h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 19px;
    color: var(--ink);
  }
  p { font-size: 14px; line-height: 1.55; color: var(--body); }
  .badge {
    margin-top: auto;
    align-self: flex-start;
    font-size: 12px;
    font-weight: 600;
    color: var(--muted);
    background: var(--paper);
    border: 1px solid var(--line);
    padding: 3px 10px;
    border-radius: 999px;
  }
</style>
