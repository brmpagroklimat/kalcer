---
// Ikon geometris dari bentuk-bentuk dasar, mengikuti desain.
import type { IconName } from '../data/tools';
interface Props { name: IconName }
const { name } = Astro.props;
---
<span class:list={['ti', name]} aria-hidden="true">
  {name === 'drought' && (
    <>
      <span class="a" style="left:0;bottom:0;width:44px;height:22px;background:var(--sand);border-radius:0 0 4px 4px"></span>
      <span class="a" style="left:8px;top:0;width:28px;height:28px;background:var(--sun);border-radius:50%"></span>
    </>
  )}
  {name === 'flood' && (
    <>
      <span style="width:44px;height:14px;background:var(--sky);border-radius:22px 22px 0 0"></span>
      <span style="width:44px;height:14px;background:var(--deep);border-radius:22px 22px 0 0"></span>
    </>
  )}
  {name === 'pest' && (
    <>
      <span class="a" style="left:0;top:4px;width:38px;height:38px;background:var(--leaf);border-radius:0 100% 0 100%"></span>
      <span class="a" style="right:0;top:0;width:16px;height:16px;background:var(--coral);border-radius:50%"></span>
    </>
  )}
  {name === 'water' && (
    <span style="width:30px;height:30px;background:var(--sky);border-radius:0 50% 50% 50%;transform:rotate(45deg)"></span>
  )}
  {name === 'fertilizer' && (
    <>
      <span class="a" style="left:0;bottom:0;width:44px;height:22px;background:var(--sand);border-radius:22px 22px 0 0"></span>
      <span class="a" style="left:11px;top:0;width:22px;height:22px;background:var(--leaf);border-radius:100% 0 100% 0"></span>
    </>
  )}
  {name === 'chat' && (
    <>
      <span style="width:24px;height:24px;background:var(--deep);border-radius:100% 100% 100% 0"></span>
      <span style="width:17px;height:17px;background:var(--coral);border-radius:100% 100% 0 100%;margin-bottom:20px"></span>
    </>
  )}
</span>

<style>
  .ti { width: 44px; height: 44px; position: relative; display: flex; flex: none; }
  .ti span { display: block; }
  .ti .a { position: absolute; }
  .flood { flex-direction: column; justify-content: flex-end; gap: 3px; }
  .water { align-items: center; justify-content: center; }
  .chat { gap: 3px; align-items: flex-end; }
</style>
