---
import Icon from './Icon.astro';
import { chatTool } from '../data/tools';
---
<section class="ask" aria-labelledby="ask-title">
  <span class="icon"><Icon name="chat" size={40} /></span>
  <div class="text">
    <h2 id="ask-title">{chatTool.title}</h2>
    <p>{chatTool.description}</p>
  </div>
  {chatTool.href ? (
    <a class="btn" href={chatTool.href} target="_blank" rel="noopener">Mulai chat<span class="sr-only"> (tab baru)</span></a>
  ) : (
    <span class="btn soon">Segera hadir</span>
  )}
</section>

<style>
  .ask {
    display: grid;
    gap: 1.25rem 2rem;
    align-items: center;
    margin-block: 1rem 4rem;
    padding: clamp(1.75rem, 4vw, 2.75rem);
    border-radius: 24px;
    background: var(--paddy);
    color: var(--leaf);
  }
  .icon { color: var(--harvest); }
  h2 {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 800;
    line-height: 1;
  }
  p { margin-top: 0.6rem; max-width: 48ch; color: color-mix(in srgb, var(--leaf) 88%, transparent); }
  .btn {
    justify-self: start;
    background: var(--harvest);
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
    padding: 0.85rem 1.6rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  a.btn:hover { background: #ecc35a; }
  .btn.soon {
    background: color-mix(in srgb, var(--leaf) 18%, transparent);
    color: var(--leaf);
    font-weight: 600;
  }
  @media (min-width: 48rem) {
    .ask { grid-template-columns: auto 1fr auto; }
    .btn { justify-self: end; }
  }
</style>
