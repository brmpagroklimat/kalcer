---
const year = new Date().getFullYear();
---
<footer>
  <div class="wrap">
    <p><strong>KALCER</strong>, Klinik Agroklimat Cerdas</p>
    <p>&copy; {year} <a href="https://agroklimat.id">agroklimat.id</a></p>
  </div>
</footer>

<style>
  footer { border-top: 1px solid var(--leaf-deep); padding-block: 2rem; color: var(--muted); font-size: var(--step--1); }
  .wrap { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 2rem; }
  strong { color: var(--ink); }
</style>
