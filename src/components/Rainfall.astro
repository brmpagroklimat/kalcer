---
// Ilustrasi pola hujan monsun (mm per dasarian, 36 dasarian setahun).
// Bukan data observasi; hanya visual hero.
const rain = [
  120, 135, 110, 125, 140, 105, 115, 95, 100, 85, 70, 62,
  55, 44, 38, 30, 22, 25, 18, 12, 15, 8, 10, 6,
  14, 20, 28, 42, 55, 68, 80, 95, 108, 118, 130, 142,
];
const DRY = 50;
const MAX = 150;
const months = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
---
<figure class="rainfall">
  <div class="plot">
    <div class="threshold" style={`bottom:${(DRY / MAX) * 100}%`}></div>
    <ol class="bars">
      {rain.map((mm, i) => (
        <li
          class:list={['bar', { dry: mm < DRY }]}
          style={`--h:${(mm / MAX) * 100}%; --i:${i}`}
        >
          <span class="sr-only">{months[Math.floor(i / 3)]} dasarian {(i % 3) + 1}: {mm} mm</span>
        </li>
      ))}
    </ol>
  </div>
  <ol class="months" aria-hidden="true">
    {months.map((m) => <li>{m}</li>)}
  </ol>
  <figcaption>
    <span class="key wet">Dasarian basah</span>
    <span class="key dry">Dasarian kering (di bawah {DRY} mm, garis putus-putus)</span>
    <span class="note">Ilustrasi pola hujan monsun per dasarian (10 hari)</span>
  </figcaption>
</figure>

<style>
  .rainfall { margin: 0; }
  .plot {
    position: relative;
    height: clamp(9rem, 22vw, 15rem);
    border-bottom: 2px solid color-mix(in srgb, var(--leaf) 55%, transparent);
  }
  .bars {
    list-style: none;
    margin: 0;
    padding: 0;
    height: 100%;
    display: grid;
    grid-template-columns: repeat(36, 1fr);
    align-items: end;
    gap: clamp(2px, 0.5vw, 6px);
  }
  .bar {
    height: var(--h);
    background: #7fb3d6;
    border-radius: 999px 999px 0 0;
    transform-origin: bottom;
    animation: grow 900ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    animation-delay: calc(var(--i) * 22ms + 150ms);
  }
  .bar.dry { background: var(--harvest); }
  @keyframes grow {
    from { transform: scaleY(0); }
    to { transform: scaleY(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .bar { animation: none; }
  }
  .threshold {
    position: absolute;
    inset-inline: 0;
    border-top: 1.5px dashed color-mix(in srgb, var(--harvest) 80%, transparent);
    z-index: 1;
    pointer-events: none;
  }
  .months {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    font-size: var(--step--1);
    color: color-mix(in srgb, var(--leaf) 70%, transparent);
  }
  .months li { text-align: center; }
  figcaption {
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: var(--step--1);
    color: color-mix(in srgb, var(--leaf) 80%, transparent);
  }
  .key { display: inline-flex; align-items: center; gap: 0.5rem; }
  .key::before {
    content: '';
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 3px;
  }
  .key.wet::before { background: #7fb3d6; }
  .key.dry::before { background: var(--harvest); }
  .note { margin-left: auto; }
  @media (max-width: 40rem) {
    .months li:nth-child(even) { visibility: hidden; }
    .note { margin-left: 0; flex-basis: 100%; }
  }
</style>
